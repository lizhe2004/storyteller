# .env.example
# 复制此文件为 .env，并填写强密码、随机密钥和所需的 API Key；不要提交真实密钥

# ===== 全局配置 =====
# 所有生成物收在同一个根目录：stories/<project_id>/（状态、分段、剧本、最终音频）与 sounds/（音效库）
STORYTELLER_DATA_DIR=./.storyteller
# 也可分别覆盖（留空即跟随 DATA_DIR）：
# STORYTELLER_OUTPUT_DIR=
# STORYTELLER_PROJECT_DIR=
STORYTELLER_LOG_LEVEL=info

# ===== Web =====
# 逗号分隔的访问密码；未配置时 storyteller web 拒绝启动。生产环境请替换占位值
STORYTELLER_WEB_PASSWORDS=replace-with-a-strong-password
# Cookie 签名密钥；生产环境必须替换为长期随机值（例如 openssl rand -hex 32）
STORYTELLER_WEB_SECRET=replace-with-a-long-random-secret
STORYTELLER_WEB_TOKEN_TTL_DAYS=30
STORYTELLER_WEB_RATE_LIMIT_PER_MIN=10
STORYTELLER_WEB_HOST=127.0.0.1
STORYTELLER_WEB_PORT=8000
STORYTELLER_WEB_CONCURRENCY=2
# STORYTELLER_WEB_FILLER_VOICE=volcengine:zh_female_popo
# 登录后可在 /settings 管理 Web 与 provider 配置；后台覆盖配置优先于环境变量。
# Docker Compose 将覆盖数据目录为 /data，并把后台配置持久化到 /data/config/settings.json。

# 音色匹配方式：llm=大模型语义匹配（默认，失败自动回退规则）；rule=仅规则
STORYTELLER_VOICE_MATCHER=llm

# ===== LLM Provider =====
# PROVIDERS 为可选的默认启用/排序列表：配了下面的 per-provider 变量即可被
# --default-llm-provider 选用，不必把名字写进这里
STORYTELLER_LLM_PROVIDERS=volcengine
STORYTELLER_LLM_DEFAULT_PROVIDER=volcengine

# 火山引擎 LLM
STORYTELLER_LLM_VOLCENGINE_API_KEY=your_api_key_here
STORYTELLER_LLM_VOLCENGINE_MODEL=doubao-seed-1-6-251015
STORYTELLER_LLM_VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# ===== TTS Provider =====
# 默认候选 provider；本次运行可用 --tts-providers 覆盖
STORYTELLER_TTS_PROVIDERS=volcengine

# 火山引擎 TTS (v3 seed-tts 单向流式接口)
STORYTELLER_TTS_VOLCENGINE_API_KEY=your_api_key_here
STORYTELLER_TTS_VOLCENGINE_RESOURCE_ID=seed-tts-2.0
STORYTELLER_TTS_VOLCENGINE_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# 阿里云百炼 TTS（Qwen-Audio-TTS，北京地域，可选的第二 TTS provider）
# 启用：取消注释填写 TYPE + DASHSCOPE API Key 即自动注册，可直接 --tts-providers aliyun 选用
# （可选）把 aliyun 加进 PROVIDERS 只影响默认启用与排序：
# STORYTELLER_TTS_PROVIDERS=volcengine,aliyun
# STORYTELLER_TTS_ALIYUN_TYPE=aliyun
# STORYTELLER_TTS_ALIYUN_API_KEY=your_dashscope_key_here
# STORYTELLER_TTS_ALIYUN_MODEL=qwen-audio-3.0-tts-flash
# 业务空间专属域名（推荐，把 WorkspaceId 换成真实空间 ID）；留空走通用域名
# STORYTELLER_TTS_ALIYUN_ENDPOINT=https://dashscope.aliyuncs.com
# STORYTELLER_TTS_ALIYUN_ENDPOINT=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com

# ===== 音效 / 背景音乐（seed-audio，默认关闭）=====
# 开启后写剧本会附带音效/BGM 提示，生成时自动混音；CLI 也可用 --with-sfx 开启
STORYTELLER_SOUND_ENABLED=false
# 全局共享音效库目录（相同音效只生成一次，跨项目复用）；留空即 <DATA_DIR>/sounds
# STORYTELLER_SOUND_DIR=./.storyteller/sounds
# 音效是独立 provider 分组（与 LLM/TTS 同构）：配了 key 即可被 --sound-provider
# 选用；下面两个 PROVIDERS/DEFAULT 变量均可选
# STORYTELLER_SOUND_PROVIDERS=volcengine
# STORYTELLER_SOUND_DEFAULT_PROVIDER=volcengine
# 独立音效 Key（不复用 TTS Key；启用音效必填）
STORYTELLER_SOUND_VOLCENGINE_API_KEY=
STORYTELLER_SOUND_VOLCENGINE_MODEL=seed-audio-1.0
# STORYTELLER_SOUND_VOLCENGINE_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/create
