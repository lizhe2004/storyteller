# .env.example
# 复制此文件为 .env，并填写强密码、随机密钥和所需的 API Key；不要提交真实密钥

# ===== 全局配置 =====
# 所有生成物收在同一个根目录：stories/<project_id>/（状态、分段、剧本、最终音频）与 sounds/（音效库）
STORYTELLER_DATA_DIR=./.storyteller
# 也可分别覆盖（留空即跟随 DATA_DIR）：
# STORYTELLER_OUTPUT_DIR=
# STORYTELLER_PROJECT_DIR=
STORYTELLER_LOG_LEVEL=info

# ===== Web =====
# 可选：逗号分隔的访问密码。不设置时，首次打开 Web 页面可通过启动日志中的一次性码设置
# STORYTELLER_WEB_PASSWORDS=replace-with-a-strong-password
# 可选：Cookie 签名密钥。不设置时首次密码设置会生成并持久化随机密钥
# STORYTELLER_WEB_SECRET=replace-with-a-long-random-secret
STORYTELLER_WEB_TOKEN_TTL_DAYS=30
STORYTELLER_WEB_RATE_LIMIT_PER_MIN=10
STORYTELLER_WEB_HOST=127.0.0.1
STORYTELLER_WEB_PORT=8000
STORYTELLER_WEB_CONCURRENCY=2
# 实时 Web 主持人音色，格式为 provider:voice_id；留空则自动选择旁白音色
# STORYTELLER_TTS_HOST_VOICE=volcengine:zh_female_popo
# 登录后可在 /settings 管理 Web 与 provider 配置；后台覆盖配置优先于环境变量。
# Docker Compose 将覆盖数据目录为 /data，并把后台配置持久化到 /data/config/settings.json。

# 音色匹配方式：llm=大模型语义匹配（默认，失败自动回退规则）；rule=仅规则
STORYTELLER_VOICE_MATCHER=llm

# ===== LLM Provider =====
# 一次运行只使用一个 LLM provider；未配置时仅在自动发现到唯一 provider 时使用
STORYTELLER_LLM_PROVIDER=volcengine

# 火山引擎 LLM
STORYTELLER_LLM_VOLCENGINE_API_KEY=your_api_key_here
STORYTELLER_LLM_VOLCENGINE_MODEL=deepseek-v4-flash-260425

# ===== TTS Provider =====
# TTS 可用 provider 列表（逗号分隔）。设置后仅名单内 provider 可用；
# 删除或留空则自动发现所有已配置 Key 的内置 provider；自定义 provider 仍需额外配置 TYPE。
STORYTELLER_TTS_PROVIDERS=volcengine

# 火山引擎 TTS (v3 seed-tts 单向流式接口)
STORYTELLER_TTS_VOLCENGINE_API_KEY=your_api_key_here
STORYTELLER_TTS_VOLCENGINE_RESOURCE_ID=seed-tts-2.0

# 阿里云百炼 TTS（Qwen-Audio-TTS，北京地域，可选的第二 TTS provider）
# 启用：填写 DASHSCOPE API Key，并将上面的 TTS_PROVIDERS 改为 volcengine,aliyun：
# STORYTELLER_TTS_ALIYUN_API_KEY=your_dashscope_key_here
# Qwen-Audio-TTS/CosyVoice 双向流式 WebSocket 所需的业务空间 ID；HTTP/WebSocket URL 由程序自动拼接
# STORYTELLER_TTS_ALIYUN_WORKSPACE_ID=your_workspace_id
# 允许音色匹配使用的模型白名单（逗号分隔，精确匹配）；不设置则启用 catalog 里的全部模型
# 典型场景：flash 免费额度用完，只保留 plus（plus 同样计费，确认账户有额度）
# STORYTELLER_TTS_ALIYUN_MODELS=qwen-audio-3.0-tts-plus
# 注：阿里云「实时」流式 TTS（Web 播放）需要额外安装 SDK：pip install ".[aliyun]"（即 dashscope）；
# 未安装时自动降级为整行 HTTP TTS，不影响 CLI 与出片。火山实时走内置 websocket-client，无需额外依赖。

# ===== 实时 TTS 调度器（仅 Web 流式；不配置即用下面的默认值）=====
# Web 开场/正文使用双向实时 TTS，按 (provider, model) 维度做 FIFO 并发、文本限速与背压；
# 实时通道不可用或超时会自动降级为整行 HTTP TTS，CLI 行为完全不变。
# STORYTELLER_TTS_SCHEDULER_MAX_CONCURRENT_SESSIONS=1
# 每秒文本块限速；留空或 0 表示不限速
# STORYTELLER_TTS_SCHEDULER_MAX_TEXT_CHUNKS_PER_SECOND=
# STORYTELLER_TTS_SCHEDULER_QUEUE_SIZE=16
# 排队等待超时；留空或 0 表示一直排队，不因槽位不足降级
# STORYTELLER_TTS_SCHEDULER_QUEUE_TIMEOUT_SECONDS=
# 针对单个 provider 覆盖默认值（PROVIDER 为小写 provider 名，名字可含下划线）：
# STORYTELLER_TTS_SCHEDULER_LIMITS_ALIYUN_MAX_CONCURRENT_SESSIONS=2
# STORYTELLER_TTS_SCHEDULER_LIMITS_ALIYUN_QUEUE_SIZE=8

# ===== 音效 / 背景音乐（seed-audio，默认关闭）=====
# 开启后写剧本会附带音效/BGM 提示，生成时自动混音；CLI 也可用 --with-sfx 开启
STORYTELLER_SOUND_ENABLED=false
# 全局共享音效库目录（相同音效只生成一次，跨项目复用）；留空即 <DATA_DIR>/sounds
# STORYTELLER_SOUND_DIR=./.storyteller/sounds
# 一次运行只使用一个音效 provider；未配置时仅在自动发现到唯一 provider 时使用
# STORYTELLER_SOUND_PROVIDER=volcengine
# 独立音效 Key（不复用 TTS Key；启用音效必填）
# STORYTELLER_SOUND_VOLCENGINE_API_KEY=
STORYTELLER_SOUND_VOLCENGINE_MODEL=seed-audio-1.0
